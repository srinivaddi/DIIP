# DIIP (Digital Institutional Intelligence Platform) Environment Configurations

# Toggle between "gemini" and "local" (for Ollama, LM Studio, etc.)
LLM_PROVIDER=local|gemini
GEMINI_API_KEY=GEMINI_API_KEY

# Local LLM endpoint settings (used if LLM_PROVIDER=local)
LOCAL_LLM_URL=LOCAL_LLM_URL
LOCAL_LLM_MODEL=LocalOllamamodelname

# Resilient Cascade Ingestion parameters (cascade, rss, json_api, sec_edgar, news_feed, html_scraper)
FORCE_INGEST_METHOD=cascade

# 2. Database Configurations
# Primary relational database connection
DATABASE_URL=DATABASE_URL

# Vector Database (ChromaDB / Qdrant / Pinecone) for semantic research search
VECTOR_DB_URL=VECTOR_DB_URL
VECTOR_DB_API_KEY=VECTOR_DB_API_KEY

# 3. Third-Party Integrations
# Required User-Agent format for SEC Edgar filings access (e.g., "Company Admin admin@company.com")
SEC_USER_AGENT=DIIP_Platform_Admin_your_email@company.com

# 4. Alert Routing Configurations
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER_USER=your_email@gmail.com
EMAIL_SENDER_PASSWORD=your_app_password

# 5. Application Hosting Configurations
PORT=8000
HOST=0.0.0.0
ENV=development

# 6. Broker Execution Configurations (Alpaca API)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
